    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = $input.all().map(i => i.json).filter(r => r.timestamp);\nconst since = Date.now() - 7 * 24 * 60 * 60 * 1000;\nconst recent = rows.filter(r => new Date(r.timestamp).getTime() >= since);\n\nconst byRole = {};\nfor (const r of recent) {\n  const k = r.role || 'Unknown';\n  byRole[k] ??= { total: 0, scored: 0, sum: 0, Shortlisted: 0, Review: 0, Rejected: 0 };\n  const b = byRole[k];\n  b.total++;\n  if (r.score !== '' && !isNaN(Number(r.score))) { b.scored++; b.sum += Number(r.score); }\n  if (b[r.decision] !== undefined) b[r.decision]++;\n}\n\nconst roleRows = Object.entries(byRole).map(([role, b]) =>\n  `<tr><td>${role}</td><td>${b.total}</td><td>${b.scored ? Math.round(b.sum / b.scored) : '-'}</td><td>${b.Shortlisted}</td><td>${b.Review}</td><td>${b.Rejected}</td></tr>`\n).join('');\n\nconst top = recent.filter(r => r.score !== '' && !isNaN(Number(r.score)))\n  .sort((a, b) => Number(b.score) - Number(a.score)).slice(0, 5)\n  .map(r => `<li><b>${r.name}</b> – ${r.role} – ${r.score}/100 (<a href=\"${r.cv_link}\">CV</a>)</li>`).join('');\n\n// Rough estimate: ~6 minutes of manual screening saved per CV\nconst hoursSaved = (recent.length * 6 / 60).toFixed(1);\n\nconst html = `\n<h2>Weekly Hiring Report</h2>\n<p><b>${recent.length}</b> applications in the last 7 days · approx. <b>${hoursSaved} hours</b> of manual screening saved</p>\n<table border=\"1\" cellpadding=\"6\" cellspacing=\"0\">\n<tr><th>Role</th><th>Applications</th><th>Avg score</th><th>Shortlisted</th><th>Review</th><th>Rejected</th></tr>\n${roleRows || '<tr><td colspan=\"6\">No applications this week</td></tr>'}\n</table>\n<h3>Top 5 candidates</h3>\n<ol>${top || '<li>None yet</li>'}</ol>`;\n\nreturn [{ json: { subject: `Weekly hiring report – ${recent.length} applications`, html } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
